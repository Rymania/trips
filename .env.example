# Supabase project used for accounts (specs/005-user-settings).
# Both values are public by design and end up in the browser bundle.
# Local stack: run `npx supabase start`, then copy API_URL and PUBLISHABLE_KEY
# from `npx supabase status -o env`. Leave empty to run the app without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put the service-role / secret key here or in any VITE_ variable.
